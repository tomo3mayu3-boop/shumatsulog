# --- OS / エディタのゴミ ---
.DS_Store
Thumbs.db
desktop.ini
*~
*.tmp
*.bak
*.swp

# --- 秘匿情報（誤コミット防止）---
.env
.env.*
*.key
*.pem
.dev.vars

# --- ビルド / ツール ---
.lighthouseci/
node_modules/
dist/
.cache/

# --- ローカル同期スクリプトのログ（端末ごと・未追跡で同期を止めないため）---
scripts/*.log

# --- 画像原本（重い・EXIF混入の恐れ）---
*.HEIC
*.heic

# --- 旅行記事: iPhoneから受け取った原本（GPS/EXIF付き。変換前・絶対に公開しない）---
drafts/incoming/

# --- 作業用・ローカルのみ（公開しない。同期のDIRTY停止を避ける）---
_template_*.md
drafts/*.json
staging/*
!staging/.gitkeep

# ルート直下のローカルなテスト/プレビュー/診断HTML（_cmp_ / _v3 / _p4test /
# _preview_ / _iosdiag などの実験用。公開記事は travel-*.html 等で _始まりは無い）
/_*.html

# 動画の一時・実験用フォルダ（公開資産は assets/video/<記事>/ 側）
assets/video/_q/

# Windows のインターネットショートカット（サイト資産ではない。images/ 等への誤保存対策）
*.url
