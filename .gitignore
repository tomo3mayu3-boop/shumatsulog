# --- OS / エディタのゴミ ---
.DS_Store
Thumbs.db
desktop.ini
*~
*.tmp
*.bak
*.swp

# --- 秘匿情報（誤コミット防止）---
.env
.env.*
*.key
*.pem
.dev.vars

# --- ビルド / ツール ---
.lighthouseci/
node_modules/
dist/
.cache/

# --- ローカル同期スクリプトのログ（端末ごと・未追跡で同期を止めないため）---
scripts/*.log

# --- 画像原本（重い・EXIF混入の恐れ）---
*.HEIC
*.heic

# --- 旅行記事: iPhoneから受け取った原本（GPS/EXIF付き。変換前・絶対に公開しない）---
drafts/incoming/

# --- 作業用・ローカルのみ（公開しない。同期のDIRTY停止を避ける）---
_template_*.md
drafts/*.json
staging/*
!staging/.gitkeep

# --- Journey Engine 検証用（ローカルのみ・公開/コミットしない）---
_cmp_journey_video.html
_cmp_transition.html
_iosdiag.html
_p4test.html
_preview_x60.html
_v3q.html
_v3test.html
assets/video/_q/
